{
  "name": "local-isv-dict",
  "version": "0.1.0",
  "description": "Local Interslavic dictionary lookup for LLMs: CLI, HTTP API and MCP server",
  "private": true,
  "type": "module",
  "bin": {
    "isv-dict": "src/cli.js"
  },
  "scripts": {
